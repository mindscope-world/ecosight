{
  "name": "capital-atlas",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": { "node": ">=22" },
  "scripts": {
    "db:up": "docker compose -f infra/docker-compose.yml up -d --build --wait",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @atlas/db migrate",
    "db:seed": "pnpm --filter @atlas/db seed",
    "db:test": "pnpm --filter @atlas/db test-db",
    "layers:build": "pnpm --filter @atlas/api build-layers",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "e2e": "pnpm --filter @atlas/web e2e"
  }
}
