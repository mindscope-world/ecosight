# Local development defaults; copy to .env. Never commit real credentials.
DATABASE_URL=postgres://atlas:atlas@localhost:5433/atlas
# Tests run here, on the synthetic sample, so they never touch the records above.
TEST_DATABASE_URL=postgres://atlas:atlas@localhost:5433/atlas_test
API_PORT=4000
WEB_PORT=5173
# Dev basemap (OpenFreeMap, no key). Production moves to self-hosted Protomaps PMTiles.
VITE_BASEMAP_STYLE=https://tiles.openfreemap.org/styles/positron
VITE_BASEMAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark
VITE_API_URL=/api

# Workers. Raw documents are kept under data/raw unless RAW_STORE_DIR is set.
# CRAWLER_USER_AGENT=CapitalAtlasBot/0.1 (+mailto:you@example.org)
# Extraction model on Groq (free tier), called through LangChain.
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# The status bar says "Demo data" until this is false. Set it when real data is loaded.
VITE_DEMO_DATA=true

# API in production. Locally these can stay unset.
# The data is private: a deployed API must have ACCESS_KEY set, and only people given
# the key can open the app. Use a long random value.
# ACCESS_KEY=
# RATE_LIMIT_PER_MINUTE=120
# CORS_ORIGINS=https://your-site.example
# TRUST_PROXY=1
# Sign-in by emailed link, through a Supabase project. Without these only the access key works.
# The API checks tokens with the first pair; the web app is built with the second (the same values).
# The publishable key is meant to be public. Who is let in is the list kept with `pnpm users`.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_URL=https://<project>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=
# Local work only: treat every request as this user, with no sign-in. Ignored when ACCESS_KEY is set.
# DEV_USER=you@example.org
# Read the map's data from static files built by `pnpm layers:build` instead of the API.
# VITE_DATA_URL=data
